# Database & Redis (Host port 5433 for Postgres 16; Windows Postgres owns 5432)
POSTGRES_USER=darkhold
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=darkhold_exchange

DATABASE_URL=postgresql://darkhold:local_dev_only_change_me@localhost:5433/darkhold_exchange?schema=public
TEST_DATABASE_URL=postgresql://darkhold:local_dev_only_change_me@localhost:5433/darkhold_test?schema=public
REDIS_URL=redis://localhost:6379

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Cryptographic & Session Secrets (Must be at least 32 characters in production)
JWT_SECRET=replace_for_local_development
SESSION_SECRET=session_secret_at_least_32_characters_for_darkhold_exchange
CSRF_SECRET=csrf_secret_at_least_32_characters_for_darkhold_exchange
POW_SECRET=pow_secret_at_least_32_characters_for_darkhold_exchange
ESCROW_SECRET=escrow_secret_at_least_32_characters_for_darkhold_exchange

# Operational Mode: "shared" (persistent multi-user demo) or "offline" (local judging mode with sim enabled)
MARKET_MODE=offline
FORCE_START=false

# Account Registration & Starter Grants
REGISTRATION_ENABLED=true
STARTER_GRANT_DKC=100000

# Group-Commit Persistence Engine
PERSIST_BATCH_MAX=100
PERSIST_BATCH_MS=5

# Anti-Bot & Proof of Work (PoW) Configuration
POW_REQUIRED=true
POW_MIN_DIFFICULTY=10
POW_MAX_DIFFICULTY=22
RATE_LIMIT_PROFILE=standard
MAX_OPEN_ORDERS_PER_USER=50
RATE_LIMIT_ORDERS_PER_SEC=50
RATE_LIMIT_CANCELS_PER_SEC=50

# Market Controls
COLLAR_BPS_DEFAULT=1000
ESCROW_TIMEOUT_SEC=300

# Seed Passwords (if unset, random passwords will be generated and saved in .demo-credentials.local)
ADMIN_PASSWORD=admin_darkhold_2026
DEMO_PASSWORD=demo_darkhold_2026

# Simulator Configuration
SIM_SEED=1337
SIM_ARRIVAL_RATE=10