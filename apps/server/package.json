{
  "name": "@darkhold/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "tsx ../../db/migrator.ts",
    "db:seed": "tsx ../../db/seed.ts",
    "test:db:setup": "tsx test/setup.ts",
    "test": "vitest run --fileParallelism=false",
    "sim:start": "tsx src/sim/simulator.ts --standalone",
    "reset:demo": "tsx src/reset-demo.ts"
  },
  "dependencies": {
    "@darkhold/engine": "workspace:*",
    "@darkhold/shared": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
