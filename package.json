{
  "name": "darkhold-exchange",
  "private": true,
  "packageManager": "pnpm@12.11.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "test:engine": "pnpm --filter @darkhold/engine test",
    "test:shared": "pnpm --filter @darkhold/shared test",
    "test:server": "pnpm --filter @darkhold/server test",
    "test:db:setup": "pnpm --filter @darkhold/server run test:db:setup",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "db:migrate": "pnpm --filter @darkhold/server run db:migrate",
    "db:seed": "pnpm --filter @darkhold/server run db:seed",
    "dev:server": "pnpm --filter @darkhold/server run dev",
    "dev:web": "pnpm --filter @darkhold/web run dev",
    "dev": "pnpm --parallel --filter @darkhold/server --filter @darkhold/web run dev",
    "sim:start": "pnpm --filter @darkhold/server run sim:start",
    "reset:demo": "pnpm --filter @darkhold/server run reset:demo",
    "bench:engine": "tsx bench/engine-bench.ts",
    "bench:core": "tsx bench/core-bench.ts",
    "bench:http": "node bench/http-bench.mjs",
    "bench:k6": "k6 run bench/k6-load.js",
    "bench:locust": "locust -f bench/locustfile.py --headless -u 50 -r 10 --run-time 15s --host http://localhost:3000",
    "bench:locust:ui": "locust -f bench/locustfile.py --host http://localhost:3000",
    "demo:sim": "tsx bench/demo-simulator.ts",
    "bench:report": "tsx bench/report.ts",
    "bench:load:market": "k6 run --summary-export=results/k6-market.json tests/load/readiness-market-load.js",
    "bench:load:auth": "k6 run --summary-export=results/k6-auth.json tests/load/auth-and-wallet-load.js",
    "bench:load": "pnpm run bench:load:market && pnpm run bench:load:auth"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}